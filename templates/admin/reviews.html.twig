{% extends 'base.html.twig' %}

{% block title %}Reviews | Caballero Industries Admin{% endblock %}

{% block body %}
<div class="admin-layout">
    {% include 'partials/sidebar.html.twig' %}

    <main class="admin-main">
        {% include 'partials/navbar.html.twig' %}

        <section class="admin-content">
            <div class="page-heading">
                <div>
                    <span class="eyebrow">// FEEDBACK CONTROL</span>
                    <h1>Reviews</h1>
                    <p>Moderate customer reviews, product ratings, and feedback.</p>
                </div>
            </div>

            <div class="admin-card">
                <div class="admin-review-feed">
                    {% for review in reviews %}
                        <article style="padding: 18px 0; border-bottom: 1px solid var(--border); display: grid; grid-template-columns: 42px minmax(0, 1fr) auto; gap: 16px; align-items: flex-start;">
                            <div class="admin-review-avatar" style="width: 42px; height: 42px; font-size: 12px;">
                                {{ review.customer_name|slice(0, 1) }}
                            </div>
                            <div>
                                <div class="admin-review-meta">
                                    <strong style="font-size: 13px;">{{ review.customer_name }}</strong>
                                    <span style="color: var(--accent); font-size: 11px;">
                                        {% for i in 1..review.rating %}★{% endfor %}
                                    </span>
                                </div>
                                <small style="font-size: 10px; color: #7f8a90; margin-top: 4px;">{{ review.product_name }} · {{ review.created_at|date('M d, Y') }}</small>
                                <p style="margin-top: 8px; font-size: 12px; color: #c3c9cd; line-height: 1.5;">{{ review.comment }}</p>
                            </div>
                            <div>
                                <button class="admin-row-link" style="color: #ff6a6a; border-color: rgba(255, 106, 106, 0.4); cursor: pointer; background: transparent;">DELETE</button>
                            </div>
                        </article>
                    {% endfor %}
                </div>
            </div>
        </section>
    </main>
</div>
{% endblock %}
