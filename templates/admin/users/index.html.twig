{% extends 'base.html.twig' %}

{% block title %}User & Staff Management | Caballero Industries Admin{% endblock %}

{% block body %}
<div class="admin-layout">
    {% include 'partials/sidebar.html.twig' %}

    <main class="admin-main">
        {% include 'partials/navbar.html.twig' %}

        <section class="admin-content">
            <div class="page-heading" style="display: flex; justify-content: space-between; align-items: flex-end;">
                <div>
                    <span class="eyebrow">// ACCESS CONTROL & ACCOUNTS</span>
                    <h1>Users & Staff Management</h1>
                    <p>Manage administrators, staff operators, customer accounts, and security permissions.</p>
                </div>
                <div>
                    <a href="{{ path('admin_users_new') }}" class="admin-btn" style="background: var(--color-accent, #ff6500); color: #000; font-weight: 700; text-decoration: none; padding: 10px 18px; border-radius: 4px;">+ CREATE USER / STAFF</a>
                </div>
            </div>

            {% for message in app.flashes('success') %}
                <div style="background: #103820; border-left: 4px solid #2ecc71; color: #d4edda; padding: 12px 16px; margin-bottom: 20px; font-size: 13px;">
                    {{ message }}
                </div>
            {% endfor %}

            {% for message in app.flashes('error') %}
                <div style="background: #3c1218; border-left: 4px solid #e74c3c; color: #f8d7da; padding: 12px 16px; margin-bottom: 20px; font-size: 13px;">
                    {{ message }}
                </div>
            {% endfor %}

            <!-- Filter & Search Toolbar -->
            <div class="admin-card" style="margin-bottom: 20px; padding: 16px 20px;">
                <form method="get" action="{{ path('admin_users_index') }}" style="display: flex; gap: 14px; align-items: center; flex-wrap: wrap;">
                    <div style="flex: 1; min-width: 240px;">
                        <input type="text" name="q" value="{{ search }}" placeholder="Search by name or email..." style="width: 100%; background: #0b0d0f; border: 1px solid #262b30; color: #fff; padding: 9px 14px; font-size: 13px; border-radius: 4px;">
                    </div>
                    <div>
                        <select name="role" style="background: #0b0d0f; border: 1px solid #262b30; color: #fff; padding: 9px 14px; font-size: 13px; border-radius: 4px;">
                            <option value="">All Roles</option>
                            <option value="ROLE_ADMIN" {{ role_filter == 'ROLE_ADMIN' ? 'selected' : '' }}>Administrators</option>
                            <option value="ROLE_STAFF" {{ role_filter == 'ROLE_STAFF' ? 'selected' : '' }}>Staff Members</option>
                            <option value="ROLE_USER" {{ role_filter == 'ROLE_USER' ? 'selected' : '' }}>Customers</option>
                        </select>
                    </div>
                    <button type="submit" class="admin-btn" style="background: #1c2127; border: 1px solid #333d47; color: #fff; padding: 9px 18px; border-radius: 4px; cursor: pointer;">
                        FILTER
                    </button>
                    {% if search or role_filter %}
                        <a href="{{ path('admin_users_index') }}" style="color: #888; font-size: 12px; text-decoration: underline; margin-left: 8px;">Reset</a>
                    {% endif %}
                </form>
            </div>

            <!-- Users Table -->
            <div class="admin-card">
                <div class="admin-table-scroll">
                    <table class="admin-dashboard-table" style="width: 100%; border-collapse: collapse;">
                        <thead>
                            <tr style="border-bottom: 2px solid #222; text-align: left;">
                                <th style="padding: 12px 14px;">NAME</th>
                                <th style="padding: 12px 14px;">EMAIL</th>
                                <th style="padding: 12px 14px;">ROLE</th>
                                <th style="padding: 12px 14px;">STATUS</th>
                                <th style="padding: 12px 14px;">CREATED AT</th>
                                <th style="padding: 12px 14px; text-align: right;">ACTIONS</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for u in users %}
                                <tr style="border-bottom: 1px solid #1a1e23;">
                                    <td style="padding: 12px 14px;">
                                        <strong>{{ u.firstname }} {{ u.lastname }}</strong>
                                        {% if app.user and app.user.id == u.id %}
                                            <span style="font-size: 10px; background: #222; color: #888; padding: 2px 6px; border-radius: 3px; margin-left: 6px;">YOU</span>
                                        {% endif %}
                                    </td>
                                    <td style="padding: 12px 14px; color: #a4abb3;">{{ u.email }}</td>
                                    <td style="padding: 12px 14px;">
                                        {% if 'ROLE_ADMIN' in u.roles %}
                                            <span style="background: #4a1515; color: #ff8888; padding: 3px 8px; border-radius: 3px; font-size: 10px; font-weight: 700;">ADMIN</span>
                                        {% elseif 'ROLE_STAFF' in u.roles %}
                                            <span style="background: #17384e; color: #64b5f6; padding: 3px 8px; border-radius: 3px; font-size: 10px; font-weight: 700;">STAFF</span>
                                        {% else %}
                                            <span style="background: #182618; color: #81c784; padding: 3px 8px; border-radius: 3px; font-size: 10px; font-weight: 700;">CUSTOMER</span>
                                        {% endif %}
                                    </td>
                                    <td style="padding: 12px 14px;">
                                        {% if u.status == 'active' %}
                                            <span style="color: #2ecc71; font-size: 11px; font-weight: 600;">● ACTIVE</span>
                                        {% else %}
                                            <span style="color: #e74c3c; font-size: 11px; font-weight: 600;">● DISABLED</span>
                                        {% endif %}
                                    </td>
                                    <td style="padding: 12px 14px; color: #767d86; font-size: 12px;">
                                        {{ u.createdat ? u.createdat|date('M d, Y') : '—' }}
                                    </td>
                                    <td style="padding: 12px 14px; text-align: right;">
                                        <div style="display: inline-flex; gap: 8px; align-items: center;">
                                            <a href="{{ path('admin_users_edit', {'id': u.id}) }}" class="admin-row-link" style="color: #ff6500; text-decoration: none; font-size: 11px; font-weight: 600;">
                                                EDIT
                                            </a>

                                            {% if app.user and app.user.id != u.id %}
                                                <form method="post" action="{{ path('admin_users_toggle_status', {'id': u.id}) }}" style="display: inline;">
                                                    <input type="hidden" name="_token" value="{{ csrf_token('toggle_status' ~ u.id) }}">
                                                    <button type="submit" style="background: none; border: none; color: #a4abb3; font-size: 11px; cursor: pointer; text-decoration: underline; padding: 0;">
                                                        {{ u.status == 'active' ? 'DISABLE' : 'ENABLE' }}
                                                    </button>
                                                </form>

                                                <form method="post" action="{{ path('admin_users_delete', {'id': u.id}) }}" onsubmit="return confirm('Are you sure you want to delete user {{ u.email }}? This action cannot be undone.');" style="display: inline;">
                                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ u.id) }}">
                                                    <button type="submit" style="background: none; border: none; color: #e74c3c; font-size: 11px; cursor: pointer; text-decoration: underline; padding: 0;">
                                                        DELETE
                                                    </button>
                                                </form>
                                            {% endif %}
                                        </div>
                                    </td>
                                </tr>
                            {% else %}
                                <tr>
                                    <td colspan="6" style="padding: 30px; text-align: center; color: #888;">No users found matching your criteria.</td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </section>
    </main>
</div>
{% endblock %}
