{% extends 'base.html.twig' %}

{% block title %}Products | Caballero Industries Admin{% endblock %}

{% block body %}
<div class="admin-layout">
    {% include 'partials/sidebar.html.twig' %}

    <main class="admin-main">
        {% include 'partials/navbar.html.twig' %}

        <section class="admin-content">
            <div class="page-heading" style="display: flex; justify-content: space-between; align-items: flex-end;">
                <div>
                    <span class="eyebrow">// PRODUCT & STOCK CONTROL</span>
                    <h1>Products</h1>
                    <p>Manage product catalog, pricing, discounts, stock levels, and store visibility.</p>
                </div>
                <div>
                    <a href="#" class="admin-btn">+ ADD PRODUCT</a>
                </div>
            </div>

            <div class="admin-card">
                <div class="admin-table-scroll">
                    <table class="admin-dashboard-table">
                        <thead>
                            <tr>
                                <th>CODE</th>
                                <th>ITEM</th>
                                <th>PRICE</th>
                                <th>DISCOUNT</th>
                                <th>STOCK</th>
                                <th>STATUS</th>
                                <th>SOLD</th>
                                <th>FLAGS</th>
                                <th>ACTIONS</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for product in products %}
                                <tr>
                                    <td><strong>{{ product.sku }}</strong></td>
                                    <td>
                                        <div style="display: flex; align-items: center; gap: 10px;">
                                            <span>{{ product.name }}</span>
                                        </div>
                                    </td>
                                    <td>₱{{ product.baseprice|number_format(2) }}</td>
                                    <td>{{ product.discountPercent > 0 ? product.discountPercent ~ '%' : '—' }}</td>
                                    <td><b>{{ product.totalStock }}</b></td>
                                    <td>
                                        {% if product.totalStock == 0 %}
                                            <span class="admin-stock-badge stock-zero">OUT OF STOCK</span>
                                        {% elseif product.totalStock <= 5 %}
                                            <span class="admin-stock-badge stock-low">LOW STOCK</span>
                                        {% else %}
                                            <span class="admin-stock-badge stock-ok">IN STOCK</span>
                                        {% endif %}
                                    </td>
                                    <td>{{ product.variants|length }} variants</td>
                                    <td>
                                        {% if product.isfeatured %}
                                            <span class="badge-flag">FEATURED</span>
                                        {% endif %}
                                    </td>
                                    <td>
                                        <div style="display: flex; gap: 6px;">
                                            <a href="#" class="admin-row-link">EDIT</a>
                                            <a href="#" class="admin-row-link">RESTOCK</a>
                                        </div>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </section>
    </main>
</div>
{% endblock %}
