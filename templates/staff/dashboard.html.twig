{% extends 'base.html.twig' %}

{% block title %}Staff Operations Portal | Caballero Industries{% endblock %}

{% block body %}
{% include 'partials/store_header.html.twig' %}

<main id="main" style="padding: 40px 20px; max-width: 1100px; margin: 0 auto;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 30px;">
        <div>
            <span style="font-size: 11px; letter-spacing: 0.15em; color: #64b5f6;">// OPERATIONAL_STATION</span>
            <h1 style="margin: 6px 0 0; font-size: 26px;">STAFF PORTAL</h1>
            <p style="color: #888; font-size: 13px;">Logged in as: <strong>{{ app.user.firstname }} {{ app.user.lastname }}</strong> ({{ app.user.email }})</p>
        </div>
        <div>
            <span style="padding: 6px 14px; background: #17384e; color: #64b5f6; font-size: 12px; font-weight: 700; border-radius: 4px;">ROLE_STAFF</span>
        </div>
    </div>

    <!-- Quick Navigation / Stats -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 20px; margin-bottom: 30px;">
        <div style="background: #111417; border: 1px solid #222; border-radius: 6px; padding: 20px;">
            <span style="font-size: 11px; color: #888; letter-spacing: 0.1em; display: block; margin-bottom: 6px;">OPERATIONAL RECORDS</span>
            <h3 style="margin: 0; color: #64b5f6; font-size: 18px;">Product Management</h3>
            <p style="color: #aaa; font-size: 12px; margin-top: 8px;">Create new records, update or delete your own inventory entries.</p>
            <div style="margin-top: 14px;">
                <a href="{{ path('staff_products_index') }}" class="btn btn-primary" style="padding: 7px 14px; font-size: 11px; text-decoration: none;">MANAGE RECORDS →</a>
            </div>
        </div>

        <div style="background: #111417; border: 1px solid #222; border-radius: 6px; padding: 20px;">
            <span style="font-size: 11px; color: #888; letter-spacing: 0.1em; display: block; margin-bottom: 6px;">ADMIN DASHBOARD</span>
            <h3 style="margin: 0; color: #ff6500; font-size: 18px;">Restricted</h3>
            <p style="color: #aaa; font-size: 12px; margin-top: 8px;">Direct attempts to access <code>/admin/*</code> routes will be rejected with HTTP 403 Access Denied.</p>
        </div>
    </div>
</main>

{% include 'partials/store_footer.html.twig' %}
{% endblock %}
