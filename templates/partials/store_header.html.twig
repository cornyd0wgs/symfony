<!-- =========================================================
     TACTICAL STATUS BAR
========================================================== -->
<div class="status-bar" id="statusBar">
    <div class="container status-bar-inner">
        <span class="status-left">{{ status_left|default('[ LOC. 14.5995° N / 120.9842° E ] // SECURE_LINE_ONLINE')|raw }}</span>
        <span class="status-right">{{ status_right|default('VER. 25.4.19 // TACTICAL_CORE') }}</span>
    </div>
</div>

<!-- =========================================================
     SITE HEADER / NAVIGATION
========================================================== -->
<header class="site-header" id="siteHeader">
    <div class="container header-inner">
        <a href="{{ path('app_home') }}" class="logo" aria-label="Caballero Industries — Home">
            <img src="{{ asset('assets/header-logo.png') }}" alt="Caballero Industries logo" class="logo-img">
        </a>

        <button class="hamburger" id="hamburgerBtn" aria-label="Toggle navigation menu" aria-expanded="false">
            <span class="hamburger-line"></span>
            <span class="hamburger-line"></span>
            <span class="hamburger-line"></span>
        </button>

        <nav class="main-nav" id="mainNav">
            <ul class="nav-list">
                <li>
                    <a href="{{ current_page|default('') == 'home' ? '#home' : path('app_home') ~ '#home' }}"
                       class="nav-link {{ current_page|default('') == 'home' ? 'active' : '' }}"
                       data-nav-key="home"
                       data-section="home">
                        HOME
                    </a>
                </li>
                <li>
                    <a href="{{ current_page|default('') == 'home' ? '#about' : path('app_home') ~ '#about' }}"
                       class="nav-link"
                       data-nav-key="about"
                       data-section="about">
                        ABOUT
                    </a>
                </li>
                <li>
                    <a href="{{ current_page|default('') == 'home' ? '#drop' : path('app_home') ~ '#drop' }}"
                       class="nav-link"
                       data-nav-key="drop"
                       data-section="drop">
                        ACTIVE DROP
                    </a>
                </li>
                <li>
                    <a href="{{ path('app_products') }}"
                       class="nav-link {{ current_page|default('') == 'gallery' ? 'active' : '' }}"
                       data-nav-key="gallery">
                        VAULT CATALOG
                    </a>
                </li>
                <li>
                    <a href="{{ path('app_contact') }}"
                       class="nav-link {{ current_page|default('') == 'contact' ? 'active' : '' }}"
                       data-nav-key="contact">
                        CONTACT
                    </a>
                </li>

                <li class="nav-divider" aria-hidden="true"></li>

                <li>
                    <a href="{{ path('app_cart') }}"
                       class="nav-link {{ current_page|default('') == 'cart' ? 'active' : '' }}"
                       data-nav-key="cart">
                        CART {% if cart_count|default(0) > 0 %}<span class="cart-badge">{{ cart_count }}</span>{% endif %}
                    </a>
                </li>

                {% if is_granted('ROLE_ADMIN') %}
                    <li>
                        <a href="{{ path('admin_dashboard') }}"
                           class="nav-link"
                           data-nav-key="admin"
                           style="color: var(--color-accent); font-weight: 800;">
                            // ADMIN
                        </a>
                    </li>
                    <li>
                        <a href="{{ path('app_logout') }}" class="nav-link" data-nav-key="logout">
                            LOGOUT
                        </a>
                    </li>
                {% elseif is_granted('IS_AUTHENTICATED_FULLY') %}
                    <li>
                        <a href="{{ path('app_account_dashboard') }}"
                           class="nav-link {{ current_page|default('') == 'account' ? 'active' : '' }}"
                           data-nav-key="account">
                            ACCOUNT
                        </a>
                    </li>
                    <li>
                        <a href="{{ path('app_logout') }}" class="nav-link" data-nav-key="logout">
                            LOGOUT
                        </a>
                    </li>
                {% else %}
                    <li>
                        <a href="{{ path('app_login') }}"
                           class="nav-link {{ current_page|default('') == 'login' ? 'active' : '' }}"
                           data-nav-key="login">
                            LOGIN
                        </a>
                    </li>
                {% endif %}
            </ul>
        </nav>
    </div>
</header>
