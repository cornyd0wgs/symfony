{% extends 'base.html.twig' %}

{% block title %}My Account | Caballero Industries{% endblock %}

{% block body %}
{% include 'partials/store_header.html.twig' %}

<main id="main">
    <section class="account-shell" style="padding-top: 50px; padding-bottom: 80px;">
        <div class="container">
            <section class="account-masthead" style="margin-bottom: 30px;">
                <div class="account-masthead-copy">
                    <p class="account-kicker tech-label">// CUSTOMER ACCOUNT // PERSONAL HUB</p>
                    <h1 class="section-heading" style="font-size: 36px; margin-bottom: 10px;">MY ACCOUNT</h1>
                    <p class="body-text">Track your orders, manage your profile, and return to the collection when you are ready.</p>
                </div>
            </section>

            {% include 'partials/account_nav.html.twig' %}

            <!-- Account Summary Metrics -->
            <div class="account-stats-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 20px; margin-top: 30px; margin-bottom: 40px;">
                <article class="account-stat-card" style="background: #111518; border: 1px solid var(--color-border); padding: 22px;">
                    <span style="font-family: var(--font-ui); font-size: 10px; color: var(--color-gray-soft); letter-spacing: 0.14em; display: block; margin-bottom: 6px;">TOTAL ORDERS</span>
                    <strong style="font-size: 28px; font-family: var(--font-heading); color: #fff;">{{ order_count }}</strong>
                    <small style="display: block; font-size: 11px; color: var(--color-accent); margin-top: 4px;">{{ completed_count }} completed</small>
                </article>

                <article class="account-stat-card" style="background: #111518; border: 1px solid var(--color-border); padding: 22px;">
                    <span style="font-family: var(--font-ui); font-size: 10px; color: var(--color-gray-soft); letter-spacing: 0.14em; display: block; margin-bottom: 6px;">INVESTMENT TOTAL</span>
                    <strong style="font-size: 28px; font-family: var(--font-heading); color: var(--color-accent);">₱{{ total_spent|number_format(2) }}</strong>
                    <small style="display: block; font-size: 11px; color: var(--color-gray-soft); margin-top: 4px;">Settled field gear</small>
                </article>

                <article class="account-stat-card" style="background: #111518; border: 1px solid var(--color-border); padding: 22px;">
                    <span style="font-family: var(--font-ui); font-size: 10px; color: var(--color-gray-soft); letter-spacing: 0.14em; display: block; margin-bottom: 6px;">ACTIVE CART</span>
                    <strong style="font-size: 28px; font-family: var(--font-heading); color: #fff;">{{ cart_count }} ITEMS</strong>
                    <small style="display: block; font-size: 11px; color: var(--color-gray-soft); margin-top: 4px;">Pending allocation</small>
                </article>

                <article class="account-stat-card" style="background: #111518; border: 1px solid var(--color-border); padding: 22px;">
                    <span style="font-family: var(--font-ui); font-size: 10px; color: var(--color-gray-soft); letter-spacing: 0.14em; display: block; margin-bottom: 6px;">OPERATOR STATUS</span>
                    <strong style="font-size: 24px; font-family: var(--font-heading); color: #62d887;">VERIFIED // ACTIVE</strong>
                    <small style="display: block; font-size: 11px; color: var(--color-gray-soft); margin-top: 4px;">Tier 1 Cleared</small>
                </article>
            </div>

            <!-- Recent Orders Card -->
            <div style="background: #111518; border: 1px solid var(--color-border); padding: 28px; margin-bottom: 30px;">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 22px;">
                    <div>
                        <p class="tech-label" style="margin-bottom: 4px;">// RECENT ACTIVITY</p>
                        <h2 style="font-family: var(--font-heading); font-size: 20px;">LATEST DISPATCHES</h2>
                    </div>
                    <a href="{{ path('app_account_orders') }}" class="btn btn-outline" style="font-size: 10px; padding: 6px 14px;">VIEW ALL DISPATCHES →</a>
                </div>

                <div class="account-order-list">
                    {% for order in recent_orders %}
                        <article style="display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 14px; padding: 16px; border-bottom: 1px solid var(--color-border); align-items: center;">
                            <div>
                                <span style="display: block; font-size: 9px; color: var(--color-gray-soft); letter-spacing: 0.12em;">ORDER REF</span>
                                <strong style="font-family: var(--font-heading); font-size: 14px; color: #fff;">#{{ order.id }}</strong>
                            </div>
                            <div>
                                <span style="display: block; font-size: 9px; color: var(--color-gray-soft); letter-spacing: 0.12em;">DATE</span>
                                <strong style="font-size: 12px; color: #fff;">{{ order.created_at|date('M d, Y') }}</strong>
                            </div>
                            <div>
                                <span style="display: block; font-size: 9px; color: var(--color-gray-soft); letter-spacing: 0.12em;">AMOUNT</span>
                                <strong style="font-size: 14px; font-family: var(--font-heading); color: var(--color-accent);">₱{{ order.total_amount|number_format(2) }}</strong>
                            </div>
                            <div>
                                <span style="display: block; font-size: 9px; color: var(--color-gray-soft); letter-spacing: 0.12em;">STATUS</span>
                                <span class="admin-badge admin-badge-{{ order.status }}">{{ order.status|upper }}</span>
                            </div>
                        </article>
                    {% endfor %}
                </div>
            </div>

            <!-- Profile snippet -->
            <div style="background: #111518; border: 1px solid var(--color-border); padding: 28px;">
                <p class="tech-label" style="margin-bottom: 4px;">// OPERATOR DOSSIER</p>
                <h3 style="font-family: var(--font-heading); font-size: 20px; margin-bottom: 16px;">IDENTIFICATION</h3>
                <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 16px; font-size: 13px;">
                    <div>
                        <span style="color: var(--color-gray-soft); font-size: 10px; display: block;">NAME</span>
                        <strong style="color: #fff;">{{ user.full_name }}</strong>
                    </div>
                    <div>
                        <span style="color: var(--color-gray-soft); font-size: 10px; display: block;">SECURE EMAIL</span>
                        <strong style="color: #fff;">{{ user.email }}</strong>
                    </div>
                    <div>
                        <span style="color: var(--color-gray-soft); font-size: 10px; display: block;">ACCOUNT CREATED</span>
                        <strong style="color: #fff;">{{ user.created_at|date('M d, Y') }}</strong>
                    </div>
                </div>
            </div>
        </div>
    </section>
</main>

{% include 'partials/store_footer.html.twig' %}
{% endblock %}
