{% extends 'base.html.twig' %}

{% block title %}Sign In | Caballero Industries{% endblock %}

{% block body %}
{% include 'partials/store_header.html.twig' %}

<main id="main">
    <section class="auth-section">
        <div class="container auth-container">
            <p class="tech-label">// SECURE_LOGIN</p>
            <h1 class="section-heading">LOG IN</h1>

            {% if error %}
                <ul class="form-message form-message-error">
                    <li>{{ error }}</li>
                </ul>
            {% endif %}

            {% for message in app.flashes('success') %}
                <div class="form-message form-message-success">
                    {{ message }}
                </div>
            {% endfor %}

            <form class="auth-form" method="post" action="{{ path('app_login') }}">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                <div class="form-row">
                    <label for="email">EMAIL</label>
                    <input
                        type="email"
                        id="email"
                        name="email"
                        required
                        value="{{ last_username|default('') }}"
                        placeholder="operator@domain.com"
                        autocomplete="email"
                    >
                </div>

                <div class="form-row">
                    <label for="password">PASSWORD</label>
                    <input
                        type="password"
                        id="password"
                        name="password"
                        required
                        placeholder="••••••••"
                        autocomplete="current-password"
                    >
                </div>

                <button type="submit" class="btn btn-primary">
                    LOG IN <span class="arrow">→</span>
                </button>
            </form>

            <div class="auth-switch auth-switch-panel">
                <span>DON'T HAVE AN ACCOUNT?</span>
                <a class="btn btn-secondary auth-signup-btn" href="{{ path('app_register') }}">
                    CREATE ACCOUNT <span class="arrow">→</span>
                </a>
            </div>
        </div>
    </section>
</main>

{% include 'partials/store_footer.html.twig' %}
{% endblock %}
